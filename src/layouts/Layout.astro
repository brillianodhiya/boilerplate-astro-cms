---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_ICON, formatTitle } from '../lib/site';

const path = Astro.url.pathname;
function initialLabel(p: string) {
  if (p.startsWith('/admin')) {
    const seg = p.replace(/^\/admin\/?/, '');
    if (!seg) return 'Dashboard';
    const base = seg.split('/')[0];
    const map: Record<string, string> = {
      sample: 'Sample Page',
      settings: 'Settings',
    };
    return map[base] ?? 'Dashboard';
  }
  if (p.startsWith('/login')) return 'Login';
  return 'Login';
}
const pageLabel = initialLabel(path);
const pageTitle = formatTitle(pageLabel);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={SITE_ICON} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={SITE_DESCRIPTION} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
