---
import Layout from '../layouts/Layout.astro';
import LoginApp from '../react/pages/LoginApp.tsx';
---

<!-- Jika token tersedia, arahkan ke dashboard; jika tidak, tampilkan login -->
<script>
  const TOKEN_KEY = 'bp_access_token';
  try {
    const token = localStorage.getItem(TOKEN_KEY);
    if (token) {
      window.location.href = '/admin';
    }
  } catch (e) {
    // Jika access ke localStorage gagal, biarkan halaman login tampil
  }
</script>

<Layout>
  <LoginApp client:only="react" />
</Layout>
