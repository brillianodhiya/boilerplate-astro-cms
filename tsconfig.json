{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@react/*": ["src/react/*"],
      "@features/*": ["src/react/features/*"],
      "@pages/*": ["src/react/pages/*"],
      "@assets/*": ["src/assets/*"]
    }
  }
}
